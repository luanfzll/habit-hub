# Copy to .env and fill in. Values below match docker-compose.yml for local development.

# Postgres connection (local: docker compose; production: Neon pooled connection string, region aws-sa-east-1)
DATABASE_URL="postgresql://habithub:habithub@localhost:5434/habithub"
# Direct (non-pooled) connection used only by migrations; on Neon it is set by the Vercel integration
DATABASE_URL_UNPOOLED=""
# Database used by the integration tests (created by docker/create-test-database.sql)
TEST_DATABASE_URL="postgresql://habithub:habithub@localhost:5434/habithub_test"

# Better Auth: generate the secret with `openssl rand -base64 32`
BETTER_AUTH_SECRET=""
# Who may sign up: "*" for anyone, or comma-separated e-mails. Unset = open locally, closed in production.
SIGNUP_ALLOWLIST=""

# Public URL of the app (local dev server runs on port 3100)
BETTER_AUTH_URL="http://localhost:3100"

# E-mail: "console" prints e-mails to the terminal; "gmail" sends through Gmail SMTP
EMAIL_TRANSPORT="console"
# With "console", also saves each e-mail as JSON here (the end-to-end tests open the links)
EMAIL_OUTBOX_DIR=".outbox"
# Required when EMAIL_TRANSPORT="gmail" (dedicated Gmail account + 16-character app password)
GMAIL_USER=""
GMAIL_APP_PASSWORD=""

# --- Production (Vercel) only; leave empty locally -------------------------------
# Sentry: errors are only sent when the DSN is set. The auth token uploads source maps at build time.
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
# Neon API access, used to back up the database before each production migration
NEON_API_KEY=""
NEON_PROJECT_ID=""
# Set to "true" on Preview only once every preview has its own Neon branch
MIGRATE_PREVIEW_DATABASE=""
