{
  "name": "habithub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3100",
    "build": "next build",
    "start": "next start --port 3100",
    "lint": "eslint --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test:unit": "TZ=America/Sao_Paulo vitest run --project unit && TZ=Asia/Tokyo vitest run --project unit",
    "test:integration": "TZ=America/Sao_Paulo vitest run --project integration && TZ=Asia/Tokyo vitest run --project integration",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "postinstall": "prisma generate",
    "db:seed": "tsx --conditions=react-server --tsconfig tsconfig.json prisma/seed.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test",
    "readme:media": "tsx scripts/readme-media.ts",
    "vercel-build": "tsx scripts/deploy/migrate.ts && next build"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/figtree": "5.3.0",
    "@fontsource-variable/unbounded": "5.3.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@sentry/nextjs": "11.7.0",
    "better-auth": "1.7.7",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.56.0",
    "next": "16.4.2",
    "next-intl": "4.14.9",
    "next-themes": "^0.4.6",
    "nodemailer": "10.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "shadcn": "^4.21.4",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "use-intl": "4.14.9",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "18.0.7",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "pg": "8.23.1",
    "prettier": "3.9.10",
    "prisma": "7.10.1",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vitest": "5.0.4"
  },
  "engines": {
    "node": "24.x"
  }
}
